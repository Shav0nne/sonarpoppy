{
  "info": {
    "name": "SonarPoppy — Artist Images",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Test collection voor artist image en search endpoints.\n\nVul username, email en password in bij Variables. Run de Setup folder in volgorde: Signup (eenmalig) → Login → API key aanmaken. Daarna werken alle tests automatisch."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "username",
      "value": "VUL_IN"
    },
    {
      "key": "email",
      "value": "VUL_IN"
    },
    {
      "key": "password",
      "value": "VUL_IN"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwtToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.add({ key: 'x-api-key', value: pm.collectionVariables.get('apiKey') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0. Signup (eenmalig)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "auth": { "type": "noauth" },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signup geslaagd', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  console.log('Account aangemaakt: ' + body.username);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "auth": { "type": "noauth" },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login geslaagd', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.collectionVariables.set('jwtToken', body.token);",
                  "  console.log('JWT token opgeslagen!');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. API key aanmaken",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["api-keys"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API key aangemaakt', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('key');",
                  "  pm.collectionVariables.set('apiKey', body.key);",
                  "  console.log('API key opgeslagen: ' + body.prefix + '...');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Artist Images",
      "item": [
        {
          "name": "Artist image ophalen",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/radiohead/image",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "radiohead", "image"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('heeft artist en images', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('artist');",
                  "  pm.expect(body).to.have.property('images').that.is.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artist image — niet gevonden",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/xyznonexistent999/image",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "xyznonexistent999", "image"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error message', () => {",
                  "  pm.expect(pm.response.json().error).to.equal('Artist not found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artist image — spatie in naam",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/the beatles/image",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "the beatles", "image"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('artist naam correct', () => {",
                  "  pm.expect(pm.response.json().artist).to.equal('the beatles');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artist image — case insensitive",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/RADIOHEAD/image",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "RADIOHEAD", "image"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('artist is lowercase', () => {",
                  "  pm.expect(pm.response.json().artist).to.equal('radiohead');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artists zoeken",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/search?q=radio",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "radio"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('results array, max 10', () => {",
                  "  const results = pm.response.json().results;",
                  "  pm.expect(results).to.be.an('array');",
                  "  pm.expect(results.length).to.be.at.most(10);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artists zoeken — te korte query",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/search?q=r",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "r"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error message', () => {",
                  "  pm.expect(pm.response.json().error).to.include('at least 2');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Artists zoeken — zonder query",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/artists/search",
              "host": ["{{baseUrl}}"],
              "path": ["artists", "search"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
